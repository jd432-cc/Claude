{
  "id": "default",
  "label": "Default register",
  "note": "Ships as data so a car class can override it. A historic single-seater and a modern GT do not share a setup sheet, and forking the code per car is the failure mode to avoid. Copy this file, edit it, and load it in the tool.",
  "groups": [
    "Mass",
    "Ride",
    "Springs",
    "Dampers",
    "Anti-roll",
    "Geometry",
    "Tyres",
    "Transmission",
    "Brakes",
    "Aero"
  ],
