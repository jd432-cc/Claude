      "index.html",
      "css/**/*",
      "js/**/*"
    ],
    "win": {
      "target": "portable"
    }
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2"
  }
}
