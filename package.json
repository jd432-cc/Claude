{
  "name": "oumf-canbus-wiring-planner",
  "version": "0.1.0",
  "description": "CAN Bus & Wiring Loom Planner for OUMF",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win portable --x64"
  },
  "author": "OUMF",
  "license": "MIT",
  "build": {
    "appId": "org.oumf.planner",
    "productName": "OUMF Planner",
