# -----------------------------------------------------------------------
# Google Sheets MCP — credential configuration
# Copy this file to .env and fill in ONE of the three options below.
# -----------------------------------------------------------------------

# Option 1 — Service account key as a JSON string (best for CI / containers)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Option 2 — Path to a service account key JSON file
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account-key.json

# Option 3 — OAuth2 user credentials (opens a browser on first run)
# GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json
# GOOGLE_TOKEN_FILE=token.json        # where the token is cached after login
